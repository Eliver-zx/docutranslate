# 复制成 batch.toml 后填入真实 key 与目录；batch.toml 不进版本库。
# 键名会被校验：拼错或写了不认识的项直接退出并列出可用键（见 batch_translate.DEFAULTS）。

[default]
to_lang         = "简体中文"
custom_prompt   = ""    # 按任务填，例如 "人名、案号、法条编号保持原样不译"
extensions      = [".docx"]
# 全局并发闸：所有文件共享，喂满服务端 --max-num-seqs（实测 20 与 40 上限相同）。
# 与每文件的 concurrent 叠加：全局 20 × 每文件 3。要填满 20 需至少 7 个文件在飞，
# 所以 file_concurrent 得给到 10，否则全局闸永远用不满。
global_concurrent = 20
file_concurrent = 10     # 同时处理的文件数
file_retry      = 2     # 文件级重试次数
retry_backoff   = 10    # 文件级重试间隔（秒）
thinking        = "default"   # default = 不让库注入任何思考字段，别改
# 默认关思考：走 chat_template_kwargs，vLLM 真认这条。库自带的 thinking 字段对
# 含 "qwen" 的 model_id 一律套阿里云的顶层 enable_thinking，自建 vLLM 不认、静默
# 忽略（实测与不写完全一致：思考照开、token 全烧在 reasoning 里、content 为空）。
# 实测同一任务 200 token → 4 token。个别 profile 要思考就在自己那节写 true。
# 注意：chat_template_kwargs 是 vLLM/SGLang 的扩展，其他后端未验证是否接受。
enable_thinking = false
# 单次响应的 token 硬上限，防复读失控烧到上下文尽头（实测撞出过单次 330302 字符）。
# 上限同时吃掉输入预算：vLLM 发车前校验 prompt + max_tokens <= max_model_len，
# 超了直接 400（实测原文 "requested 8192 output tokens and your prompt contains
# at least 4097 input tokens, for a total of at least 12289"）。max_model_len
# 为 12288 时，8192 等于把 prompt 卡死在 4096 token 以内 —— 库的"继续获取"请求
# （原 prompt + 已输出全文）必然超，退化后把截断的半截译文当成功写进译文和缓存。
# 3072 对正常需求（实测 chunk 输出 546-1106 token）仍有 3 倍余量，
# 同时把 prompt 门槛抬到 9216 token，续写请求能合法发出。
max_tokens      = 3072
# 库的 httpx 客户端默认 trust_env=False，不读环境变量里的代理。
# 本机挂了 Clash 之类的代理、且目标端点必须走代理才通时，置为 true。
system_proxy_enable = false

# 自建 vLLM 上的小模型，走库自带的 JSON 分段协议。
# chunk_size 不要超过实例的 max_model_len（curl /v1/models 可查）。
[profile.qwen]
input       = "/path/to/输入目录"
output      = "/path/to/输出目录_qwen"
base_url    = "http://127.0.0.1:8002/v1"
api_key     = "EMPTY"
model_id    = "Qwen3.5-9B"
chunk_size  = 4000
# 每文件最多几个在飞。真正的总闸是 [default] 的 global_concurrent。
# 单段直译实测 并发10→479.9 tok/s，并发20→642.8 tok/s。
concurrent  = 3
temperature = 0.0
timeout     = 300
retry       = 4
# 实测（Qwen3.5-9B / vLLM 0.27.1，1 个 docx / 6 chunk / 40 段）：
#   关闭时缺键 19/40 (47.5%)，模型会把整个 chunk 的 id 重编号；开启后 0/40。
#   两者耗时相同（13.1s vs 13.3s），约束解码不增加开销。小模型走 docx 必开。
# force_json（response_format=json_object）默认关：实测它和 json_schema 一样，
# 逼模型填满输出、更容易撞 max_tokens 被截断，截断的 JSON 解析出来就缺键。
# 极简提示词单用即可把缺键压到 0.1%，加约束反而升到 1.4%，吞吐还掉一半。
force_json  = false
# force_json 只保证「是合法 JSON」，不保证「键齐全」：实测失败文件上仍有 2.1% 缺键，
# 一个键就够打崩整个文件。json_schema 把 required 写死全部原文 id，缺键在解码器层面
# 不可能发生（实测同一文件 0%）。需要后端支持 response_format=json_schema。
# 约束解码：实测反而更差（缺键 1.4% vs 极简提示词的 0.1%），因为它逼模型填满
# 每个 key、输出更长，更容易撞 max_tokens 被截断，截断的 JSON 解析出来就缺键。
# 而且吞吐只有无约束的 43%，且不随并发扩展。留着作为对照，默认关。
json_schema = false     # 仅在 mt=false 时生效
# 极简提示词替换库里那份 60 行带示例的长模板。四种组合实测（Qwen3.5-9B，102 chunk）：
#   库模板+约束 缺键1.4% 罢工6.2% 446tok/s     库模板+无约束 缺键2.9% 罢工7.7% 522tok/s
#   极简+约束   缺键1.4% 罢工5.3% 475tok/s     极简+无约束   缺键0.1% 罢工6.0% 567tok/s
minimal_prompt = true   # 仅在 mt=false 时生效
# 单段直译：一段一请求，按原文去重 + 段级缓存。名字叫 mt 是历史遗留，
# 它跟模型是不是 MT 无关 —— 它是把 JSON 分段协议整个删掉。
# 5 个最难文件实测：缺键/错位 0%，罢工 3.7% 且全是报关代码（本就不该翻），
# 输出 token 最少、速度最快。表格重的 6 个文件同样 0 散文拒翻。
mt          = true
# 写绝对路径 = 全语料共用一份缓存：跨批次省请求，且同一原文在所有文件里
# 译文一致。相对路径则落在本次输出目录下，分批跑会碎成多份。
mt_cache    = "~/Downloads/冰岛_全局缓存.sqlite3"
# 重试换模型：第 1 次用本 profile，第 2 次起换成指定的那个。同一个模型连失败
# 两次多半是这份文件它啃不动，再喂一遍只是把同样的错重放一次。
# 回退 profile 的 mt / json_schema / minimal_prompt 必须与本 profile 相同 ——
# 这三项是进程级全局补丁，启动时会校验并报错。
# 回退只换 API 与翻译参数（base_url/api_key/model_id/chunk_size/concurrent/
# temperature/top_p/timeout/retry/max_tokens/extra_body 等）。input、output、
# extensions、file_concurrent、file_retry、global_concurrent、mt_cache 一律
# 仍按主 profile 走 —— 回退 profile 里写的那几项是死字段，不生效。
# fallback_profile = "hunyuan"

# 专用 MT 模型，走单段直译协议 + 段级缓存，不发 JSON 分段协议。
[profile.hunyuan]
input       = "/path/to/输入目录"
output      = "/path/to/输出目录_hunyuan"
base_url    = "https://api.siliconflow.cn/v1"
api_key     = "sk-填你的key"
model_id    = "tencent/Hunyuan-MT-7B"
chunk_size  = 3000
concurrent  = 6
# 官方模型卡推荐 top_k=20, top_p=0.6, repetition_penalty=1.05, temperature=0.7。
# 这里刻意把 temperature 留在 0：段级缓存要求同一原文每次得到同样译文，0.7 会破坏
# 复用。top_k 与 repetition_penalty 照官方走，后者正是防复读的旋钮。
# 官方还说明该模型没有默认 system prompt，而库会硬塞一个 Role 段 —— 未验证影响。
temperature = 0.0
top_p       = 0.6
extra_body  = '{"top_k":20,"repetition_penalty":1.05}'
timeout     = 300
retry       = 3
mt          = true
mt_cache    = "mt_cache.sqlite3"   # 相对 output 目录

# md 换 extensions 即可；MT 单段协议只接 docx，md 走库自带的整块翻译。
[profile.hunyuan-md]
input       = "/path/to/md输入目录"
output      = "/path/to/md输出目录"
extensions  = [".md", ".markdown"]
base_url    = "https://api.siliconflow.cn/v1"
api_key     = "sk-填你的key"
model_id    = "tencent/Hunyuan-MT-7B"
chunk_size  = 3000
concurrent  = 6
temperature = 0.0
timeout     = 300
retry       = 3
mt          = false

# ============================================================================
# 自建 vLLM 跑腾讯混元翻译模型 Hy-MT2-30B-A3B（MoE，激活 3B）
#
# 服务端启动（单张 3090 24G，权重 15.4 GiB）：
#   CUDA_VISIBLE_DEVICES=6 VLLM_USE_FLASHINFER_SAMPLER=0 \
#   vllm serve <模型目录> --served-model-name Hy-MT2-30B \
#     --host 0.0.0.0 --port 8003 \
#     --max-model-len 8192 --max-num-seqs 32 --gpu-memory-utilization 0.92
#
# 两个必须带的参数，缺了起不来或必然失败：
# 1. VLLM_USE_FLASHINFER_SAMPLER=0
#    机器无 nvcc 时 FlashInfer 的采样内核要 JIT 编译，报
#    "Could not find nvcc"。注意错误出在 sampler 不是 torch.compile，
#    --enforce-eager 无效。关掉后 torch.compile 与 CUDA Graph 均正常，
#    无可观测性能代价。
# 2. --max-model-len 8192（不能用 4096）
#    冰岛语实测 2.05 字符/token，最长段 6994 字符 = 3418 token，
#    加 max_tokens 1536 = 4954 > 4096，vLLM 发车前校验直接 400。
#    库的 segments2json_chunks 按行拆，单行长段拆不开。
#    提高 max-model-len 不缩 KV 池：56,560 → 56,048 tokens（−0.9%）。
#
# 权重用 Intel/Hy-MT2-30B-A3B-int4-AutoRound（全网唯一 vLLM 可用的 4bit；
# 官方 FP8 在 3090 sm86 上没有硬件支持）。下载后必须删掉 config.json 里
# quantization_config.extra_config 那条正则 —— 它想保护 MoE router 却匹配
# 不到（router 真名 mlp.router.gate.weight），反而误伤 shared expert 的
# gate_proj，报 "Fused module ... requires consistent quant config"。
# 权重文件里所有 linear 本来就统一 4bit，router 本来就是未量化 fp16。
#
# 并发调优（30 篇 / 77.7 万字符 / 空缓存冷启动实测）：
#   4096/16          243s  599出tok/s  Running顶死16 / Waiting 4  / KV 21%
#   4096/64          177s  831出tok/s  Running中位56 / Waiting 0  / KV 81%
#   4096/64+超订100  179s  816出tok/s  Running 64    / Waiting 19~36
#   8192/32          191s  765出tok/s  Running 32    / Waiting 12 / KV 41%  ← 采用
# 32 路到 64 路只快 8%，说明 32 路时算力已近饱和，不值得拿 KV 余量去换。
# 本负载 prefill 主导（每请求入 254 / 出 84），而"加 batch 白赚"只对 decode
# 成立 —— prefill 算力受限，每 token 都要吃满 FLOPs。
#
# 该模型默认不输出思考：chat template 里 reasoning_effort 默认 no_think，
# 且在 prompt 末尾预填闭合的 <think></think>，模型物理上出不了思考块。
# 不要加 --reasoning-parser。
[profile.hymt2]
input       = "/path/to/输入目录"
output      = "/path/to/输出目录"
base_url    = "http://<服务器IP>:8003/v1"
api_key     = "EMPTY"
model_id    = "Hy-MT2-30B"
chunk_size  = 2000
file_concurrent   = 16      # 16 × 4 = 64，比服务端 max-num-seqs 32 多喂一倍
global_concurrent = 64
concurrent  = 4
# 官方模型卡：top_k=20, top_p=0.6, repetition_penalty=1.05, temperature=0.7。
# temperature 刻意压到 0：段级缓存要求同一原文每次得到同样译文。
temperature = 0.0
top_p       = 0.6
extra_body  = '{"top_k":20,"repetition_penalty":1.05}'
timeout     = 300
retry       = 3
max_tokens  = 1536          # prompt 上限 = 8192 - 1536 = 6656 token
mt          = true
mt_cache    = "~/全局缓存_hymt2.sqlite3"   # 绝对路径 = 全语料共用一份
